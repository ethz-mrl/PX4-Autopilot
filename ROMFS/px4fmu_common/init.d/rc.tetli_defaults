#!/bin/sh
#
# tetli defaults, shared by every tetli airframe (SITL and hardware).
#
# tetli is an omnidirectional hexarotor with its own controller and allocator (the tetli repo,
# px4/src/modules/tetli_control). It flies on external vision (mocap) only: no GPS, no compass.
#

set VEHICLE_TYPE tetli

param set-default MAV_TYPE 13
param set-default IMU_GYRO_RATEMAX 400

# tetli_control's topics are logged every cycle (400 Hz). The logger reads one message per topic
# and loop, so it loops at 500 Hz (SITL: see rc.tetli_apps).
set LOGGER_ARGS "${LOGGER_ARGS} -r 500"

# EKF2 on mocap: horizontal + vertical position and yaw, vision height, baro as secondary.
# The mocap link stamps CAPTURE times (time-synced), so no extra delay is assumed.
param set-default EKF2_EV_CTRL 11
param set-default EKF2_HGT_REF 3
param set-default EKF2_GPS_CTRL 0
param set-default EKF2_BARO_CTRL 1
param set-default EKF2_MAG_TYPE 5
param set-default EKF2_EV_DELAY 0
param set-default EKF2_EV_NOISE_MD 1
param set-default EKF2_EVP_NOISE 0.01
param set-default EKF2_EVA_NOISE 0.02
param set-default SYS_HAS_MAG 0
param set-default SYS_HAS_GPS 0

# Omnidirectional: every attitude is a flight attitude, so no roll/pitch failure detection.
param set-default FD_FAIL_R 0
param set-default FD_FAIL_P 0

# tetli_control publishes the land detector; arming holds the vehicle where it stands.
param set-default COM_DISARM_PRFLT -1
param set-default COM_DISARM_LAND 2
param set-default MIS_TAKEOFF_ALT 1.5

# RC (safety operator) lost: land, which tetli_control flies as its 0.5 m/s descent.
param set-default NAV_RCL_ACT 3
