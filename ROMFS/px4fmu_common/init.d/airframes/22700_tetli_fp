#!/bin/sh
#
# @name tetli, fixed pitch
#
# @type Custom
# @class Copter
#
# The tetli repo's vehicle (configs/vehicle/tetli.yaml there) on the Pixracer Pro. The real
# outputs are configured in H0; until then only HITL (SYS_HITL = 1) drives the rotors.
#

. ${R}etc/init.d/rc.tetli_defaults

param set-default TL_VEHICLE 0
param set-default TL_KATT 10

# HITL: six reversible motors on HIL outputs 1-6 (-1..1 = full reverse..full forward).
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104
param set-default HIL_ACT_FUNC5 105
param set-default HIL_ACT_FUNC6 106
